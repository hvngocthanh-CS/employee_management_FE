<Window x:Class="EmployeeManagement.DepartmentEmployeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Department Employees"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Foreground="#333333"/>

        <!-- Filters and Search -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="SortByComboBox" 
                      Width="120" 
                      Margin="0,0,15,0"
                      SelectionChanged="SortByComboBox_SelectionChanged">
                <ComboBoxItem Content="Name" Tag="name" IsSelected="True"/>
                <ComboBoxItem Content="Hire Date" Tag="hire_date"/>
                <ComboBoxItem Content="Salary" Tag="salary"/>
            </ComboBox>
            
            <TextBlock Text="Order:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="OrderComboBox" 
                      Width="100" 
                      Margin="0,0,15,0"
                      SelectionChanged="OrderComboBox_SelectionChanged">
                <ComboBoxItem Content="Ascending" Tag="asc" IsSelected="True"/>
                <ComboBoxItem Content="Descending" Tag="desc"/>
            </ComboBox>

            <TextBlock Text="Page size:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="PageSizeComboBox" 
                      Width="80" 
                      Margin="0,0,15,0"
                      SelectionChanged="PageSizeComboBox_SelectionChanged">
                <ComboBoxItem Content="10" Tag="10"/>
                <ComboBoxItem Content="20" Tag="20" IsSelected="True"/>
                <ComboBoxItem Content="50" Tag="50"/>
                <ComboBoxItem Content="100" Tag="100"/>
            </ComboBox>

            <Button Content="Refresh" 
                    Click="RefreshButton_Click"
                    Padding="10,5"
                    Background="#2196F3"
                    Foreground="White"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="EmployeesDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="*"/>
                <DataGridTextColumn Header="Position" Binding="{Binding position}" Width="150"/>
                <DataGridTextColumn Header="Hire Date" Binding="{Binding hire_date}" Width="100"/>
                <DataGridTextColumn Header="Current Salary" Binding="{Binding current_salary_formatted}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Pagination -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">
            <Button x:Name="FirstPageButton" 
                    Content="⏮ First" 
                    Click="FirstPage_Click"
                    Padding="10,5"
                    Margin="0,0,5,0"
                    Background="#4CAF50"
                    Foreground="White"
                    Cursor="Hand"/>
            <Button x:Name="PrevPageButton" 
                    Content="◀ Previous" 
                    Click="PrevPage_Click"
                    Padding="10,5"
                    Margin="0,0,5,0"
                    Background="#4CAF50"
                    Foreground="White"
                    Cursor="Hand"/>
            
            <TextBlock x:Name="PageInfoText" 
                       VerticalAlignment="Center"
                       Margin="15,0"
                       FontWeight="SemiBold"/>
            
            <Button x:Name="NextPageButton" 
                    Content="Next ▶" 
                    Click="NextPage_Click"
                    Padding="10,5"
                    Margin="5,0,0,0"
                    Background="#4CAF50"
                    Foreground="White"
                    Cursor="Hand"/>
            <Button x:Name="LastPageButton" 
                    Content="Last ⏭" 
                    Click="LastPage_Click"
                    Padding="10,5"
                    Margin="5,0,0,0"
                    Background="#4CAF50"
                    Foreground="White"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
