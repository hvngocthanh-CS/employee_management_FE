<Page x:Class="EmployeeManagement.SalariesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      Title="Salaries Management"
      Background="#ECF0F1">

    <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💰" FontSize="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Salary Information"
                              FontSize="28"
                              FontWeight="Bold"
                              Foreground="#2C3E50"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Current Salary Summary (Employee only) -->
            <Border Grid.Row="1" 
                    x:Name="CurrentSalaryPanel"
                    Background="White" 
                    BorderBrush="#BDC3C7" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="20" 
                    Margin="0,0,0,20"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Current Salary" 
                                  FontWeight="Bold" 
                                  Foreground="#2C3E50" 
                                  HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CurrentSalaryAmount" 
                                  Text="Loading..." 
                                  FontSize="24" 
                                  FontWeight="Bold" 
                                  Foreground="#27AE60" 
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Effective From" 
                                  FontWeight="Bold" 
                                  Foreground="#2C3E50" 
                                  HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EffectiveFromDate" 
                                  Text="Loading..." 
                                  FontSize="14" 
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Currency" 
                                  FontWeight="Bold" 
                                  Foreground="#2C3E50" 
                                  HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CurrencyLabel" 
                                  Text="VND" 
                                  FontSize="14" 
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Employee Search Panel (Admin/Manager only) -->
            <Border Grid.Row="2" 
                    x:Name="EmployeeSearchPanel"
                    Background="White" 
                    BorderBrush="#BDC3C7" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="20" 
                    Margin="0,0,0,20"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="🔍 Search Employee to Manage Salary"
                              FontSize="16"
                              FontWeight="Bold"
                              Foreground="#2C3E50"
                              Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Type at least 2 characters to search by name, code, or email"
                              FontSize="12"
                              Foreground="#7F8C8D"
                              Margin="0,0,0,10"/>
                    
                    <TextBox x:Name="EmployeeSearchBox"
                            Height="35"
                            FontSize="14"
                            VerticalContentAlignment="Center"
                            Text=""
                            TextChanged="EmployeeSearchBox_TextChanged"
                            Padding="10,5">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search employees..."
                                                                  Foreground="#95A5A6"
                                                                  FontStyle="Italic"
                                                                  Margin="5,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    
                    <!-- Search Results -->
                    <ListBox x:Name="EmployeeSearchResults"
                            MaxHeight="200"
                            Margin="0,10,0,0"
                            SelectionChanged="EmployeeSearchResults_SelectionChanged"
                            Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding full_name}" FontWeight="Bold"/>
                                    <TextBlock>
                                        <Run Text="Code: "/><Run Text="{Binding employee_code}"/>
                                        <Run Text=" | Email: "/><Run Text="{Binding email}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Add/Edit Salary Form (Shows after selecting employee) -->
            <Border Grid.Row="2" 
                    x:Name="AddSalaryForm"
                    Background="White" 
                    BorderBrush="#3498DB" 
                    BorderThickness="2" 
                    CornerRadius="5" 
                    Padding="20" 
                    Margin="0,0,0,20"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="💼 Manage Salary"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="#2C3E50"
                                  HorizontalAlignment="Left"/>
                        <Button Content="✕ Cancel"
                               Click="ClearButton_Click"
                               Background="#E74C3C"
                               Foreground="White"
                               Padding="10,5"
                               BorderThickness="0"
                               Cursor="Hand"
                               HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Selected Employee Info -->
                    <Border Background="#ECF0F1" 
                           Padding="10" 
                           CornerRadius="5"
                           Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Selected Employee:" 
                                      FontSize="11"
                                      Foreground="#7F8C8D"
                                      Margin="0,0,0,5"/>
                            <TextBlock x:Name="EmployeeNameTextBlock"
                                      Text="No employee selected"
                                      FontSize="14"
                                      FontWeight="Bold"
                                      Foreground="#2C3E50"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Base Salary -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Base Salary *" Foreground="#2C3E50" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="BaseSalaryTextBox"
                                        Height="35"
                                        Width="200"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="10,5"/>
                                <TextBlock Text="VND" 
                                          VerticalAlignment="Center" 
                                          Margin="10,0,0,0" 
                                          FontWeight="Bold" 
                                          Foreground="#3498DB"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Empty Column -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="Note: Enter amount without commas" 
                                      FontSize="11"
                                      Foreground="#7F8C8D" 
                                      Margin="0,0,0,5"
                                      TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Effective From -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Effective From *" Foreground="#2C3E50" Margin="0,0,0,5"/>
                            <DatePicker x:Name="EffectiveFromPicker"
                                       Height="35"
                                       SelectedDate="{x:Static System:DateTime.Now}"/>
                        </StackPanel>

                        <!-- Effective To -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="Effective To (Optional)" Foreground="#2C3E50" Margin="0,0,0,5"/>
                            <DatePicker x:Name="EffectiveToPicker"
                                       Height="35"/>
                        </StackPanel>

                        <!-- Buttons -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                   Orientation="Horizontal" 
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0">
                            <Button x:Name="AddButton"
                                   Click="AddButton_Click"
                                   Content="Add Salary"
                                   Background="#27AE60"
                                   Foreground="White"
                                   Padding="20,8"
                                   BorderThickness="0"
                                   FontWeight="Bold"
                                   Cursor="Hand"
                                   FontSize="14"
                                   Margin="0,0,10,0"/>
                            <Button Click="ClearButton_Click"
                                   Content="Cancel"
                                   Background="#95A5A6"
                                   Foreground="White"
                                   Padding="20,8"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Salary History -->
            <Border Grid.Row="3" 
                    Background="White" 
                    BorderBrush="#BDC3C7" 
                    BorderThickness="1" 
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title and Action Buttons -->
                    <Grid Grid.Row="0" Margin="15,15,15,10">
                        <TextBlock Text="Salary History"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="#2C3E50"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>

                        <Button x:Name="RefreshButton"
                               Click="RefreshButton_Click"
                               Content="🔄 Refresh"
                               Background="#3498DB"
                               Foreground="White"
                               Padding="10,5"
                               BorderThickness="0"
                               Cursor="Hand"
                               HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Loading Indicator -->
                    <TextBlock x:Name="LoadingLabel"
                              Grid.Row="1"
                              Text="Loading salary history..."
                              HorizontalAlignment="Center"
                              Margin="15"
                              Foreground="#7F8C8D"
                              FontStyle="Italic"
                              Visibility="Collapsed"/>

                    <!-- Data Grid -->
                    <DataGrid x:Name="SalaryDataGrid"
                             Grid.Row="2"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             AlternatingRowBackground="#F8F9FA"
                             Margin="15,0,15,15"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             LoadingRow="DataGrid_LoadingRow">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding RowNumber}" Width="50"/>
                            <DataGridTextColumn Header="Effective From" 
                                               Binding="{Binding effective_from, StringFormat='{}{0:dd/MM/yyyy}'}"
                                               Width="120"/>
                            <DataGridTextColumn Header="Effective To" 
                                               Binding="{Binding effective_to, StringFormat='{}{0:dd/MM/yyyy}'}"
                                               Width="120"/>
                            <DataGridTextColumn Header="Amount" 
                                               Binding="{Binding DisplayAmountWithCurrency}"
                                               Width="180"/>
                            <DataGridTextColumn Header="Employee" 
                                               Binding="{Binding employee_name}"
                                               Width="200"
                                               x:Name="EmployeeColumn"/>
                            <DataGridTextColumn Header="Username" 
                                               Binding="{Binding username}"
                                               Width="150"/>
                            <DataGridTextColumn Header="Role" 
                                               Binding="{Binding role}"
                                               Width="100"/>
                            
                            <!-- Actions Column (Manager/Admin only) -->
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏️ Edit"
                                                   Click="EditSalaryButton_Click"
                                                   Tag="{Binding}"
                                                   Background="#F39C12"
                                                   Foreground="White"
                                                   Padding="5,2"
                                                   Margin="2"
                                                   BorderThickness="0"
                                                   FontSize="11"
                                                   Visibility="Collapsed"
                                                   x:Name="EditButton"
                                                   Cursor="Hand"/>
                                            <Button Content="🗑️ Delete"
                                                   Click="DeleteSalaryButton_Click"
                                                   Tag="{Binding}"
                                                   Background="#E74C3C"
                                                   Foreground="White"
                                                   Padding="5,2"
                                                   Margin="2"
                                                   BorderThickness="0"
                                                   FontSize="11"
                                                   Visibility="Collapsed"
                                                   x:Name="DeleteButton"
                                                   Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
    </Grid>
</Page>