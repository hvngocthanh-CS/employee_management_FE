<Window x:Class="EmployeeManagement.DepartmentStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Department Statistics"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Foreground="#333333"/>

        <!-- Summary Info -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Background="#E3F2FD" Padding="15" Margin="0,0,10,0" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Total Employees" FontSize="12" Foreground="#666"/>
                    <TextBlock x:Name="TotalEmployeesText" FontSize="20" FontWeight="Bold" Foreground="#1976D2"/>
                </StackPanel>
            </Border>
            <Border Background="#E8F5E9" Padding="15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Unique Positions" FontSize="12" Foreground="#666"/>
                    <TextBlock x:Name="UniquePositionsText" FontSize="20" FontWeight="Bold" Foreground="#388E3C"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Position Breakdown -->
        <TextBlock Grid.Row="2" 
                   Text="Employee Breakdown by Position"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>
        
        <DataGrid x:Name="PositionsDataGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Position" Binding="{Binding position_title}" Width="*"/>
                <DataGridTextColumn Header="Employees" Binding="{Binding count}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Salary Stats -->
        <Border Grid.Row="4" 
                Background="#FFF3E0" 
                Padding="15" 
                Margin="0,0,0,15"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Budget" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="TotalBudgetText" FontSize="14" FontWeight="Bold" Foreground="#E65100"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Average Salary" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="AvgSalaryText" FontSize="14" FontWeight="Bold" Foreground="#E65100"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Min Salary" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="MinSalaryText" FontSize="14" FontWeight="Bold" Foreground="#E65100"/>
                </StackPanel>
                
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Max Salary" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="MaxSalaryText" FontSize="14" FontWeight="Bold" Foreground="#E65100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Employee Info -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="#F5F5F5" Padding="15" Margin="0,0,5,0" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Newest Employee" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="NewestEmployeeText" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Background="#F5F5F5" Padding="15" Margin="5,0,0,0" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Longest Serving" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="LongestServingText" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
