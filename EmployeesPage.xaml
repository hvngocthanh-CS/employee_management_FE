<Page x:Class="EmployeeManagement.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Employees">
    
    <Page.Resources>
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="InputPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="👥 Employee Management" 
                      FontSize="24" 
                      FontWeight="Bold" 
                      Foreground="#2C3E50"/>
            <TextBlock Text="Manage employee information and records" 
                      FontSize="14" 
                      Foreground="#7F8C8D"
                      Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Add Employee Form -->
        <Border x:Name="AddEmployeeForm"
               Grid.Row="1" 
               Background="#F8F9FA" 
               BorderBrush="#E9ECEF" 
               BorderThickness="1" 
               CornerRadius="8" 
               Padding="20" 
               Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Add New Employee" 
                          FontSize="16" 
                          FontWeight="Bold" 
                          Foreground="#2C3E50" 
                          Margin="0,0,0,15"/>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- First Row -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="First Name *" Style="{StaticResource InputLabel}"/>
                        <TextBox x:Name="FirstNameTextBox" Style="{StaticResource InputTextBox}" ToolTip="Enter employee's first name"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Last Name *" Style="{StaticResource InputLabel}"/>
                        <TextBox x:Name="LastNameTextBox" Style="{StaticResource InputTextBox}" ToolTip="Enter employee's last name"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,15,0">
                        <TextBlock Text="Email *" Style="{StaticResource InputLabel}"/>
                        <TextBox x:Name="EmailTextBox" Style="{StaticResource InputTextBox}" ToolTip="Enter employee's email address"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="3">
                        <TextBlock Text="Phone" Style="{StaticResource InputLabel}"/>
                        <TextBox x:Name="PhoneTextBox" Style="{StaticResource InputTextBox}" ToolTip="Enter employee's phone number"/>
                    </StackPanel>

                    <!-- Second Row -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Password *" Style="{StaticResource InputLabel}"/>
                        <PasswordBox x:Name="PasswordBox" 
                                    Style="{StaticResource InputPasswordBox}" 
                                    ToolTip="Initial password for employee account (min 6 chars)"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Department" Style="{StaticResource InputLabel}"/>
                        <ComboBox x:Name="DepartmentComboBox" Height="32" ToolTip="Select employee's department"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,15,0">
                        <TextBlock Text="Position" Style="{StaticResource InputLabel}"/>
                        <ComboBox x:Name="PositionComboBox" Height="32" ToolTip="Select employee's position"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="3">
                        <TextBlock Text="Hire Date" Style="{StaticResource InputLabel}"/>
                        <DatePicker x:Name="HireDatePicker" Height="32" ToolTip="Select employee's hire date"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <!-- NOTE: Salary is managed separately via Salaries page (Foreign Key relationship) -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" 
                               Orientation="Horizontal" 
                               HorizontalAlignment="Right" 
                               Margin="0,10,0,0">
                        <Button x:Name="ClearButton" 
                               Content="Clear" 
                               Click="ClearButton_Click"
                               Style="{StaticResource ActionButton}"
                               Background="#6C757D" 
                               Foreground="White"/>
                        <Button x:Name="AddButton" 
                               Content="Add Employee" 
                               Click="AddButton_Click"
                               Style="{StaticResource ActionButton}"
                               Background="#28A745" 
                               Foreground="White"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Employees List -->
        <StackPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Employee List" 
                          FontSize="18" 
                          FontWeight="Bold" 
                          Foreground="#2C3E50" 
                          VerticalAlignment="Center"/>
                
                <TextBox x:Name="SearchTextBox" 
                        Width="250" 
                        Height="32"
                        Margin="20,0,10,0"
                        Padding="8"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        ToolTip="Search employees by name or email"
                        TextChanged="SearchTextBox_TextChanged"/>
                
                <Button x:Name="RefreshButton"
                       Content="🔄 Refresh"
                       Click="RefreshButton_Click"
                       Style="{StaticResource ActionButton}"
                       Background="#17A2B8"
                       Foreground="White"/>
            </StackPanel>
            
            <DataGrid x:Name="EmployeesDataGrid" 
                     AutoGenerateColumns="False" 
                     CanUserAddRows="False"
                     GridLinesVisibility="Horizontal"
                     HeadersVisibility="Column"
                     Background="White"
                     RowBackground="#FFFFFF"
                     AlternatingRowBackground="#F8F9FA"
                     BorderBrush="#DEE2E6"
                     BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="First Name" Binding="{Binding first_name}" Width="120"/>
                    <DataGridTextColumn Header="Last Name" Binding="{Binding last_name}" Width="120"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="200"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding phone}" Width="120"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding department_name}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Position" Binding="{Binding position_name}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Hire Date" Binding="{Binding hire_date, StringFormat={}{0:dd/MM/yyyy}}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Salary (VND)" Binding="{Binding salary, StringFormat='{}{0:N0}'}" Width="120" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" 
                                           Click="EditButton_Click"
                                           Tag="{Binding Id}"
                                           Style="{StaticResource ActionButton}"
                                           Background="#FFC107"
                                           Foreground="Black"
                                           FontSize="10"/>
                                    <Button Content="Delete" 
                                           Click="DeleteButton_Click"
                                           Tag="{Binding Id}"
                                           Style="{StaticResource ActionButton}"
                                           Background="#DC3545"
                                           Foreground="White"
                                           FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>