<UserControl x:Class="EmployeeManagement.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FA">

    <UserControl.Resources>
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#007BFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="0,0,0,25"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#007BFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0056B3"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#6C757D"/>
                    <Setter Property="Cursor" Value="Wait"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DemoButton" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F9FA" Offset="0"/>
                <GradientStop Color="#E9ECEF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main Login Panel -->
        <Border Background="White" 
                CornerRadius="12" 
                Width="480" 
                Height="600"
                VerticalAlignment="Center" 
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" 
                                  ShadowDepth="8" 
                                  Direction="270" 
                                  Color="#40000000" 
                                  Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Margin="40,50">
                
                <!-- Header Section -->
                <StackPanel Margin="0,0,0,40">
                    <TextBlock Text="🏢" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Employee Management" 
                              FontSize="28" 
                              FontWeight="Bold" 
                              HorizontalAlignment="Center" 
                              Foreground="#2C3E50"/>
                    <TextBlock Text="Please sign in to continue" 
                              FontSize="14" 
                              HorizontalAlignment="Center" 
                              Foreground="#6C757D"
                              Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Login Form -->
                <StackPanel>
                    <TextBlock Text="Email / Username" 
                              FontSize="14" 
                              FontWeight="SemiBold"
                              Margin="0,0,0,8" 
                              Foreground="#495057"/>
                    <TextBox x:Name="EmailTextBox" 
                            Style="{StaticResource InputTextBox}"
                            ToolTip="Enter your employee email or username"
                            KeyDown="EmailTextBox_KeyDown"/>

                    <TextBlock Text="Password" 
                              FontSize="14" 
                              FontWeight="SemiBold"
                              Margin="0,0,0,8" 
                              Foreground="#495057"/>
                    <PasswordBox x:Name="PasswordBox" 
                                Style="{StaticResource InputPasswordBox}"
                                ToolTip="Enter your password"
                                KeyDown="PasswordBox_KeyDown"/>

                    <!-- Loading Indicator -->
                    <StackPanel x:Name="LoadingIndicator" 
                               Orientation="Horizontal" 
                               HorizontalAlignment="Center"
                               Visibility="Hidden"
                               Margin="0,0,0,15">
                        <TextBlock Text="🔄" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Authenticating..." 
                                  FontSize="14" 
                                  Foreground="#6C757D"/>
                    </StackPanel>

                    <!-- Login Button -->
                    <Button x:Name="LoginButton"
                           Content="Sign In" 
                           Style="{StaticResource PrimaryButton}"
                           Click="LoginButton_Click"/>

                    <!-- Register Link for Admin/Manager -->
                    <Button Content="Admin/Manager? Register here" 
                           Height="35" 
                           FontSize="13" 
                           Background="Transparent" 
                           Foreground="#007BFF" 
                           BorderThickness="0"
                           Click="RegisterLink_Click" 
                           Cursor="Hand"
                           Margin="0,5,0,0"/>
                    
                    <TextBlock Text="Employees: Contact admin for account" 
                              Height="25" 
                              FontSize="11" 
                              Foreground="#6C757D" 
                              TextAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,0,0,10"/>
                </StackPanel>

                <!-- Demo Section -->
                <Border Background="#F8F9FA" 
                       CornerRadius="8" 
                       Padding="15"
                       Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="🚀 Quick Demo Access" 
                                  FontSize="14" 
                                  FontWeight="SemiBold"
                                  HorizontalAlignment="Center" 
                                  Foreground="#495057"
                                  Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                   Content="👑 Admin" 
                                   Style="{StaticResource DemoButton}"
                                   Background="#DC3545" 
                                   Foreground="White"
                                   BorderBrush="#DC3545"
                                   Click="AdminDemoButton_Click"
                                   ToolTip="Full access to all features"/>

                            <Button Grid.Column="1" 
                                   Content="👔 Manager" 
                                   Style="{StaticResource DemoButton}"
                                   Background="#FFC107" 
                                   Foreground="#212529"
                                   BorderBrush="#FFC107"
                                   Click="ManagerDemoButton_Click"
                                   ToolTip="Manage employees and departments"/>

                            <Button Grid.Column="2" 
                                   Content="👤 Employee" 
                                   Style="{StaticResource DemoButton}"
                                   Background="#28A745" 
                                   Foreground="White"
                                   BorderBrush="#28A745"
                                   Click="EmployeeDemoButton_Click"
                                   ToolTip="View personal information only"/>
                        </Grid>
                        
                        <TextBlock Text="Click any role above to test different permission levels" 
                                  FontSize="11" 
                                  HorizontalAlignment="Center" 
                                  Foreground="#6C757D"
                                  Margin="0,8,0,0"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>