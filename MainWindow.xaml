<Window x:Class="EmployeeManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Management System"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <!-- Styles -->
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3498DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="#2C3E50" Height="60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <TextBlock Grid.Column="0"
                          Text="Employee Management System"
                          FontSize="18"
                          FontWeight="Bold"
                          Foreground="White"
                          VerticalAlignment="Center"
                          Margin="20,0"/>

                <!-- User Info and Logout -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           Margin="10,0,20,0"
                           x:Name="UserInfoPanel"
                           Visibility="Collapsed">
                    <TextBlock x:Name="UsernameLabel"
                              Text="Welcome, User"
                              Foreground="White"
                              VerticalAlignment="Center"
                              Margin="0,0,15,0"/>
                    <Button x:Name="LogoutButton"
                           Click="LogoutButton_Click"
                           Content="Logout"
                           Padding="10,5"
                           Background="#E74C3C"
                           Foreground="White"
                           BorderThickness="0"
                           Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Side Navigation Menu -->
            <Border Grid.Column="0" 
                   Background="#34495E"
                   x:Name="SideNavPanel"
                   Visibility="Collapsed">
                <StackPanel Margin="10">
                    <Button x:Name="DashboardButton"
                           Click="NavigateToDashboard"
                           Content="📊 Dashboard"
                           Style="{StaticResource NavButtonStyle}"
                           Margin="0,5"/>
                    <Button x:Name="DepartmentsButton"
                           Click="NavigateToDepartments"
                           Content="🏢 Departments"
                           Style="{StaticResource NavButtonStyle}"
                           Margin="0,5"/>
                    <Button x:Name="PositionsButton"
                           Click="NavigateToPositions"
                           Content="💼 Positions"
                           Style="{StaticResource NavButtonStyle}"
                           Margin="0,5"/>
                    <Button x:Name="EmployeesButton"
                           Click="NavigateToEmployees"
                           Content="👥 Employees"
                           Style="{StaticResource NavButtonStyle}"
                           Margin="0,5"/>
                    <Button x:Name="UsersButton"
                           Click="NavigateToUsers"
                           Content="👤 Users"
                           Style="{StaticResource NavButtonStyle}"
                           Margin="0,5"/>
                    <Button x:Name="SalariesButton"
                           Click="NavigateToSalaries"
                           Content="💰 Salaries"
                           Style="{StaticResource NavButtonStyle}"
                           Margin="0,5"/>
                    <Button x:Name="AttendancesButton"
                           Click="NavigateToAttendances"
                           Content="⏰ Attendances"
                           Style="{StaticResource NavButtonStyle}"
                           Margin="0,5"/>
                    <Button x:Name="LeavesButton"
                           Click="NavigateToLeaves"
                           Content="🏖️ Leaves"
                           Style="{StaticResource NavButtonStyle}"
                           Margin="0,5"/>
                </StackPanel>
            </Border>

            <!-- Main Content Frame -->
            <Frame x:Name="MainFrame"
                   Grid.Column="1"
                   NavigationUIVisibility="Hidden"
                   Background="#ECF0F1"/>
        </Grid>
    </Grid>
</Window>
